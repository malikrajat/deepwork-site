# npm configuration for this repository.
#
# `audit=false` and `fund=false` are set deliberately: the pipeline for this
# project does not gate on dependency vulnerability reports, and the funding
# notice is noise in a build log. Neither setting removes the capability —
# `npm audit` still works when run by hand, and turning the gate on is a matter
# of deleting these two lines and adding a step to
# `.github/workflows/ci.yml`. See the README for the trade-off that decision
# accepts.
audit=false
fund=false

# Angular's build and Biome both write a lot; keeping the log level at warn
# makes a CI log readable.
loglevel=warn
