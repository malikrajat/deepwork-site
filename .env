# The contact form's Web3Forms access key.
#
# This file is tracked so the build carries the key with no secret configured
# anywhere: `tools/contact-config.cjs` reads it before every `npm start` and
# `npm run build` and bakes it into the built contact page. A developer can
# override it in `.env.local` (gitignored), and `process.env` wins over both.
#
# The key is not a secret in the usual sense — a Web3Forms access key can only
# deliver mail to the inbox that owns it — but it is not a password either.
WEB3FORMS_ACCESS_KEY=1688f847-6deb-4b4f-b011-1c4c377f165e
