# Compiled output
/dist
/out-tsc
/.angular/cache

# Dependencies
/node_modules

# Logs and caches
npm-debug.log*
yarn-error.log*
.prettiercache

# Editors
.idea/
.vscode/*
!.vscode/mcp.json
!.vscode/extensions.json
!.vscode/settings.json
*.launch
.settings/

# OS
.DS_Store
Thumbs.db

# Local overrides. The project's key lives in the tracked `.env`; this file is
# only for a developer pointing the form at a different account on their machine.
/.env.local
/.env.*.local

# Written by `tools/contact-config.cjs` before every start and build, from the
# environment. Generated so the access key has no reason to enter git history.
/public/contact/config.js

# Generated by `tools/` at authoring time, not by the site itself
/tools/.cache
# Raw PNG captures: several megabytes each, regenerated on demand. The WebP
# files the site ships are committed; these are not.
/tools/shots-raw
