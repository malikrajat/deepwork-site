# Optional local override. Copy to `.env.local` (gitignored) — the tracked `.env`
# already carries the project's key, so this file is only needed to point the
# form at a different Web3Forms account on your own machine.
#
# Precedence in tools/contact-config.cjs:
#   1. WEB3FORMS_ACCESS_KEY in the process environment (CI)
#   2. .env.local
#   3. .env
WEB3FORMS_ACCESS_KEY=
